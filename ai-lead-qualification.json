            },
            {
              "type": "HumanMessagePromptTemplate",
              "message": "=Analyze this lead:\n\nCustomer Name:\n{{ $json.customer_name }}\n\nCustomer Email:\n{{ $json.customer_email }}\n\nCompany:\n{{ $json.company }}\n\nProject_requirements:\n{{ $json.project_requirements }}\n\nBudget:\n{{ $json.budget }}"
